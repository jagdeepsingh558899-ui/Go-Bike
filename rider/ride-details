<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#080808">
<title>Go Bike | Ride Details</title>

<style>
:root{
    --black:#080808;
    --panel:#111;
    --panel2:#171717;
    --yellow:#ffd600;
    --white:#fff;
    --muted:#777;
    --border:rgba(255,255,255,.08);
    --green:#28d477;
    --red:#ff5656;
    --orange:#ffad32;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html,body{
    min-height:100%;
    background:var(--black);
    color:var(--white);
    font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
}

body{
    padding-bottom:30px;
}

button{
    font:inherit;
    cursor:pointer;
    -webkit-tap-highlight-color:transparent;
}

.page{
    width:100%;
    max-width:620px;
    min-height:100vh;
    margin:auto;
    padding:15px;
}

/* HEADER */

.header{
    display:flex;
    align-items:center;
    gap:10px;
}

.back{
    width:43px;
    height:43px;
    border:1px solid var(--border);
    border-radius:14px;
    background:var(--panel);
    color:#fff;
    font-size:20px;
}

.header-copy{
    flex:1;
}

.header-copy strong{
    display:block;
    font-size:17px;
    font-weight:950;
}

.header-copy span{
    display:block;
    margin-top:3px;
    color:#666;
    font-size:8px;
}

/* STATUS */

.status-card{
    margin-top:17px;
    padding:17px;
    border:1px solid var(--border);
    border-radius:19px;
    background:var(--panel);
}

.status-top{
    display:flex;
    align-items:center;
    gap:11px;
}

.status-icon{
    width:44px;
    height:44px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:13px;
    background:rgba(40,212,119,.09);
    color:var(--green);
    font-size:20px;
}

.status-copy{
    flex:1;
}

.status-copy strong{
    display:block;
    font-size:12px;
    font-weight:950;
}

.status-copy span{
    display:block;
    margin-top:4px;
    color:#666;
    font-size:7px;
}

.status-badge{
    padding:7px 9px;
    border-radius:8px;
    font-size:6px;
    font-weight:950;
    background:rgba(40,212,119,.1);
    color:var(--green);
}

/* RIDE ID */

.ride-id{
    display:flex;
    justify-content:space-between;
    gap:10px;
    margin-top:13px;
    padding-top:12px;
    border-top:1px solid var(--border);
}

.ride-id span{
    color:#555;
    font-size:6px;
    font-weight:900;
}

.ride-id strong{
    color:#aaa;
    font-size:7px;
}

/* SECTION */

.section-title{
    margin:20px 3px 8px;
    color:#555;
    font-size:7px;
    font-weight:950;
    letter-spacing:.8px;
    text-transform:uppercase;
}

/* ROUTE */

.route-card{
    padding:17px;
    border:1px solid var(--border);
    border-radius:18px;
    background:var(--panel);
}

.route-row{
    position:relative;
    display:flex;
    gap:12px;
    min-height:65px;
}

.route-row:first-child::after{
    content:"";
    position:absolute;
    left:7px;
    top:17px;
    height:47px;
    border-left:1px dashed #444;
}

.route-dot{
    position:relative;
    z-index:2;
    width:15px;
    height:15px;
    flex:0 0 15px;
    margin-top:2px;
    border-radius:50%;
    background:var(--yellow);
}

.route-dot.drop{
    border-radius:3px;
    background:#fff;
}

.route-copy{
    min-width:0;
    flex:1;
}

.route-copy span{
    display:block;
    color:#555;
    font-size:6px;
    font-weight:900;
}

.route-copy strong{
    display:block;
    margin-top:5px;
    color:#ddd;
    font-size:9px;
    line-height:1.35;
}

/* MAP PREVIEW */

.map-preview{
    position:relative;
    overflow:hidden;
    height:155px;
    margin-top:13px;
    border:1px solid var(--border);
    border-radius:15px;
    background:
        linear-gradient(135deg,#151515 25%,transparent 25%) 0 0/34px 34px,
        linear-gradient(315deg,#151515 25%,transparent 25%) 0 0/34px 34px,
        #0e0e0e;
}

.map-road{
    position:absolute;
    height:7px;
    background:#282828;
    transform:rotate(-18deg);
}

.map-road.one{
    width:120%;
    top:45%;
    left:-10%;
}

.map-road.two{
    width:100%;
    top:67%;
    left:10%;
    transform:rotate(26deg);
}

.map-road.three{
    width:80%;
    top:20%;
    left:20%;
    transform:rotate(65deg);
}

.map-point{
    position:absolute;
    z-index:2;
    width:15px;
    height:15px;
    border:3px solid #111;
    border-radius:50%;
    background:var(--yellow);
    box-shadow:0 0 0 6px rgba(255,214,0,.13);
}

.map-point.pickup{
    left:25%;
    top:55%;
}

.map-point.drop{
    right:20%;
    top:27%;
    background:#fff;
    box-shadow:0 0 0 6px rgba(255,255,255,.1);
}

.map-label{
    position:absolute;
    z-index:3;
    padding:5px 7px;
    border-radius:6px;
    background:#080808;
    color:#aaa;
    font-size:6px;
    font-weight:900;
}

/* STATS */

.stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
}

.stat{
    padding:14px 9px;
    border:1px solid var(--border);
    border-radius:14px;
    background:var(--panel);
    text-align:center;
}

.stat strong{
    display:block;
    color:#ddd;
    font-size:12px;
    font-weight:950;
}

.stat span{
    display:block;
    margin-top:5px;
    color:#555;
    font-size:5px;
    font-weight:900;
    text-transform:uppercase;
}

/* FARE */

.fare-card{
    overflow:hidden;
    border:1px solid var(--border);
    border-radius:18px;
    background:var(--panel);
}

.fare-row{
    display:flex;
    justify-content:space-between;
    gap:15px;
    padding:12px 15px;
    border-bottom:1px solid var(--border);
}

.fare-row:last-child{
    border-bottom:0;
}

.fare-row span{
    color:#777;
    font-size:7px;
}

.fare-row strong{
    color:#ddd;
    font-size:8px;
}

.fare-row.commission strong{
    color:var(--red);
}

.fare-row.earning{
    background:rgba(40,212,119,.05);
}

.fare-row.earning span{
    color:#aaa;
}

.fare-row.earning strong{
    color:var(--green);
    font-size:12px;
}

/* OTP */

.otp-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:9px;
}

.otp-card{
    padding:15px;
    border:1px solid var(--border);
    border-radius:15px;
    background:var(--panel);
    text-align:center;
}

.otp-card span{
    display:block;
    color:#555;
    font-size:6px;
    font-weight:900;
    text-transform:uppercase;
}

.otp{
    display:block;
    margin-top:8px;
    color:var(--yellow);
    font-size:22px;
    font-weight:950;
    letter-spacing:5px;
}

.otp-status{
    display:block;
    margin-top:5px;
    color:#666;
    font-size:6px;
}

/* TIMELINE */

.timeline{
    padding:17px;
    border:1px solid var(--border);
    border-radius:18px;
    background:var(--panel);
}

.timeline-item{
    position:relative;
    display:flex;
    gap:12px;
    min-height:54px;
}

.timeline-item:not(:last-child)::after{
    content:"";
    position:absolute;
    left:6px;
    top:15px;
    height:42px;
    border-left:1px solid #333;
}

.timeline-dot{
    position:relative;
    z-index:2;
    width:13px;
    height:13px;
    flex:0 0 13px;
    margin-top:1px;
    border-radius:50%;
    background:#333;
}

.timeline-item.done .timeline-dot{
    background:var(--green);
}

.timeline-copy{
    flex:1;
}

.timeline-copy strong{
    display:block;
    color:#aaa;
    font-size:8px;
}

.timeline-copy span{
    display:block;
    margin-top:3px;
    color:#555;
    font-size:6px;
}

/* CUSTOMER */

.customer-card{
    display:flex;
    align-items:center;
    gap:12px;
    padding:15px;
    border:1px solid var(--border);
    border-radius:17px;
    background:var(--panel);
}

.customer-avatar{
    width:43px;
    height:43px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:#222;
    font-size:18px;
}

.customer-info{
    flex:1;
}

.customer-info strong{
    display:block;
    color:#ddd;
    font-size:9px;
}

.customer-info span{
    display:block;
    margin-top:4px;
    color:#666;
    font-size:6px;
}

.call-btn{
    width:38px;
    height:38px;
    border:1px solid rgba(40,212,119,.2);
    border-radius:11px;
    background:rgba(40,212,119,.08);
    color:var(--green);
}

/* ACTIONS */

.actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-top:20px;
}

.action{
    min-height:43px;
    border:1px solid var(--border);
    border-radius:12px;
    background:#151515;
    color:#aaa;
    font-size:7px;
    font-weight:950;
}

.action.primary{
    border-color:rgba(255,214,0,.3);
    background:var(--yellow);
    color:#090909;
}

.action:active{
    transform:scale(.98);
}

/* LOADING */

.loading{
    position:fixed;
    z-index:1000;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#080808;
}

.loading.hide{
    display:none;
}

.spinner{
    width:34px;
    height:34px;
    border:3px solid rgba(255,255,255,.1);
    border-top-color:var(--yellow);
    border-radius:50%;
    animation:spin .8s linear infinite;
}

@keyframes spin{
    to{transform:rotate(360deg)}
}

/* TOAST */

.toast{
    position:fixed;
    z-index:2000;
    left:50%;
    bottom:24px;
    max-width:calc(100% - 30px);
    padding:10px 14px;
    border:1px solid var(--border);
    border-radius:11px;
    background:#1a1a1a;
    color:#ddd;
    font-size:8px;
    font-weight:800;
    opacity:0;
    pointer-events:none;
    transform:translate(-50%,10px);
    transition:.2s;
}

.toast.show{
    opacity:1;
    transform:translate(-50%,0);
}

.footer{
    padding:22px 5px;
    text-align:center;
    color:#444;
    font-size:7px;
}

.footer span{
    color:var(--yellow);
}
</style>
</head>

<body>

<main class="page">

<header class="header">

