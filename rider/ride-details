<script>
(function(){

"use strict";


const state = {
    ride:null,
    rideId:null
};


const $ =
    id => document.getElementById(id);


/* =========================================================
   HELPERS
========================================================= */

function getApi(){

    return (
        window.GoBikeRideEngine ||
        window.GoBikeDriver ||
        window.GoBikeAuth ||
        null
    );

}


function escapeHtml(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function num(value){

    const n = Number(value);

    return Number.isFinite(n)
        ? n
        : 0;

}


function money(value){

    return "₹" +
        Math.max(0,Math.round(num(value)))
            .toLocaleString("en-IN");

}


function dateValue(value){

    if(!value){
        return null;
    }

    if(value instanceof Date){
        return value;
    }

    if(
        value &&
        typeof value.toDate === "function"
    ){

        try{
            return value.toDate();
        }catch(error){}
    }

    if(typeof value === "number"){
        return new Date(value);
    }

    if(typeof value === "string"){

        const d = new Date(value);

        if(!Number.isNaN(d.getTime())){
            return d;
        }
    }

    return null;

}


function formatDate(value){

    const date =
        dateValue(value);

    if(!date){
        return "—";
    }

    return date.toLocaleDateString(
        "en-IN",
        {
            day:"2-digit",
            month:"short",
            year:"numeric"
        }
    ) +
    " • " +
    date.toLocaleTimeString(
        "en-IN",
        {
            hour:"2-digit",
            minute:"2-digit"
        }
    );

}


function formatTime(value){

    const date =
        dateValue(value);

    if(!date){
        return "—";
    }

    return date.toLocaleTimeString(
        "en-IN",
        {
            hour:"2-digit",
            minute:"2-digit"
        }
    );

}


/* =========================================================
   RIDE ID
========================================================= */

function getRideId(){

    const params =
        new URLSearchParams(
            window.location.search
        );

    return (
        params.get("rideId") ||
        params.get("id") ||
        localStorage.getItem(
            "goBikeSelectedRideId"
        ) ||
        localStorage.getItem(
            "selectedRideId"
        ) ||
        null
    );

}


/* =========================================================
   STATUS
========================================================= */

function statusOf(ride){

    const status =
        String(
            ride?.status ||
            ride?.rideStatus ||
            ride?.state ||
            ""
        )
        .toLowerCase()
        .trim();

    if([
        "completed",
        "complete",
        "finished",
        "success"
    ].includes(status)){
        return "completed";
    }

    if([
        "cancelled",
        "canceled",
        "rejected"
    ].includes(status)){
        return "cancelled";
    }

    if([
        "accepted",
        "arriving",
        "arrived",
        "picked_up",
        "ongoing",
        "started"
    ].includes(status)){
        return "ongoing";
    }

    return status || "pending";

}


/* =========================================================
   DATA FIELD HELPERS
========================================================= */

function pickup(ride){

    return (
        ride.pickupAddress ||
        ride.pickup?.address ||
        ride.pickup?.name ||
        ride.pickupLocation?.address ||
        ride.from ||
        "Pickup location unavailable"
    );

}


function drop(ride){

    return (
        ride.dropAddress ||
        ride.drop?.address ||
        ride.drop?.name ||
        ride.dropLocation?.address ||
        ride.to ||
        "Drop location unavailable"
    );

}


function service(ride){

    return (
        ride.serviceType ||
        ride.rideType ||
        ride.vehicleType ||
        "Bike"
    );

}


function distance(ride){

    const n =
        num(
            ride.distanceKm ??
            ride.distance ??
            ride.km
        );

    return n > 0
        ? n.toFixed(n < 10 ? 1 : 0) + " km"
        : "—";

}


function duration(ride){

    const n =
        num(
            ride.durationMinutes ??
            ride.duration ??
            ride.timeMinutes
        );

    if(n <= 0){
        return "—";
    }

    if(n < 60){
        return Math.round(n) + " min";
    }

    const h =
        Math.floor(n / 60);

    const m =
        Math.round(n % 60);

    return h + "h " + m + "m";

}


function customerFare(ride){

    return num(
        ride.customerFare ??
        ride.totalFare ??
        ride.fare ??
        ride.amount
    );

}


function earning(ride){

    return num(
        ride.driverEarning ??
        ride.driverAmount ??
        ride.netDriverFare ??
        ride.driverFare ??
        ride.earning ??
        ride.earnings
    );

}


function commission(ride){

    const explicit =
        ride.commission ??
        ride.platformFee;

    if(explicit !== undefined){
        return num(explicit);
    }

    return Math.max(
        0,
        customerFare(ride) -
        earning(ride)
    );

}


/* =========================================================
   LOAD RIDE
========================================================= */

async function loadRide(){

    const id =
        state.rideId;

    if(!id){

        throw new Error(
            "Ride ID missing"
        );

    }


    /* Selected ride passed through session */

    try{

        const raw =
            sessionStorage.getItem(
                "goBikeSelectedRide"
            );

        if(raw){

            const parsed =
                JSON.parse(raw);

            if(
                parsed &&
                (
                    parsed.id === id ||
                    parsed.rideId === id ||
                    !parsed.id
                )
            ){

                state.ride = parsed;

                return;

            }

        }

    }catch(error){}


    /* Selected ride passed through localStorage */

    try{

        const raw =
            localStorage.getItem(
                "goBikeSelectedRide"
            );

        if(raw){

            const parsed =
                JSON.parse(raw);

            if(
                parsed &&
                (
                    parsed.id === id ||
                    parsed.rideId === id ||
                    !parsed.id
                )
            ){

                state.ride = parsed;

                return;

            }

        }

    }catch(error){}


    /* Engine */

    const api =
        getApi();

    if(api){

        const methods = [
            "getRideById",
            "getRide",
            "fetchRide",
            "getRideDetails"
        ];

        for(
            const method of methods
        ){

            if(
                typeof api[method] !==
                "function"
            ){
                continue;
            }

            try{

                const result =
                    await api[method](id);

                const ride =
                    result?.ride ||
                    result;

                if(
                    ride &&
                    typeof ride === "object"
                ){

                    state.ride =
                        ride;

                    return;

                }

            }catch(error){

                console.warn(
                    method,
                    error
                );

            }

        }

    }


    /* Firestore */

    if(
        window.firebase &&
        firebase.firestore
    ){

        const doc =
            await firebase
                .firestore()
                .collection("rides")
                .doc(id)
                .get();

        if(doc.exists){

            state.ride = {
                id:doc.id,
                ...doc.data()
            };

            return;

        }

    }


    /* Local history */

    try{

        const raw =
            localStorage.getItem(
                "goBikeRideHistory"
            );

        if(raw){

            const rides =
                JSON.parse(raw);

            if(Array.isArray(rides)){

                const found =
                    rides.find(
                        ride =>
                            String(
                                ride.id ||
                                ride.rideId
                            ) === String(id)
                    );

                if(found){

                    state.ride =
                        found;

                    return;

                }

            }

        }

    }catch(error){}


    throw new Error(
        "Ride not found"
    );

}


/* =========================================================
   RENDER STATUS
========================================================= */

function renderStatus(ride){

    const status =
        statusOf(ride);


    const config = {

        completed:{
            title:"Ride Completed",
            description:
                "This ride has been successfully completed.",
            badge:"COMPLETED",
            icon:"✓",
            color:"green"
        },

        cancelled:{
            title:"Ride Cancelled",
            description:
                "This ride was cancelled.",
            badge:"CANCELLED",
            icon:"×",
            color:"red"
        },

        ongoing:{
            title:"Ride In Progress",
            description:
                "This ride is currently active.",
            badge:"ONGOING",
            icon:"●",
            color:"yellow"
        },

        pending:{
            title:"Ride Pending",
            description:
                "This ride is waiting for the next action.",
            badge:"PENDING",
            icon:"!",
            color:"orange"
        }

    };


    const c =
        config[status] ||
        config.pending;


    $("statusTitle")
        .textContent =
        c.title;

    $("statusDescription")
        .textContent =
        c.description;

    $("statusBadge")
        .textContent =
        c.badge;

    $("statusIcon")
        .textContent =
        c.icon;


    const colors = {

        green:"var(--green)",
        red:"var(--red)",
        yellow:"var(--yellow)",
        orange:"var(--orange)"

    };


    const color =
        colors[c.color];


    $("statusIcon").style.color =
        color;

    $("statusBadge").style.color =
        color;

    $("statusBadge").style.background =
        c.color === "green"
            ? "rgba(40,212,119,.1)"
            : c.color === "red"
                ? "rgba(255,86,86,.1)"
                : c.color === "yellow"
                    ? "rgba(255,214,0,.1)"
                    : "rgba(255,173,50,.1)";

}


/* =========================================================
   RENDER
========================================================= */

function render(ride){

    renderStatus(ride);


    $("rideId")
        .textContent =
        String(
            ride.id ||
            ride.rideId ||
            state.rideId ||
            "N/A"
        );


    $("pickupAddress")
        .textContent =
        pickup(ride);


    $("dropAddress")
        .textContent =
        drop(ride);


    $("distance")
        .textContent =
        distance(ride);


    $("duration")
        .textContent =
        duration(ride);


    $("service")
        .textContent =
        service(ride);


    const fare =
        customerFare(ride);

    const driverEarning =
        earning(ride);

    const platformCommission =
        commission(ride);


    $("customerFare")
        .textContent =
        money(fare);


    const base =
        num(
            ride.baseFare ??
            ride.basePrice ??
            ride.base
        );


    const extra =
        num(
            ride.extraCharges ??
            ride.surge ??
            ride.additionalCharges ??
            Math.max(
                0,
                fare - base
            )
        );


    $("baseFare")
        .textContent =
        money(
            base || fare
        );


    $("extraFare")
        .textContent =
        money(
            base
                ? extra
                : 0
        );


    $("commission")
        .textContent =
        "-" +
        money(
            platformCommission
        );


    $("earning")
        .textContent =
        money(
            driverEarning ||
            Math.max(
                0,
                fare -
                platformCommission
            )
        );


    const pickupOtp =
        ride.pickupOtp ??
        ride.pickupOTP ??
        ride.startOtp ??
        "";


    const dropOtp =
        ride.dropOtp ??
        ride.dropOTP ??
        ride.endOtp ??
        "";


    $("pickupOtp")
        .textContent =
        pickupOtp
            ? String(pickupOtp)
            : "----";


    $("dropOtp")
        .textContent =
        dropOtp
            ? String(dropOtp)
            : "----";


    $("pickupOtpStatus")
        .textContent =
        ride.pickupOtpVerified ||
        ride.pickupOTPVerified
            ? "Verified"
            : pickupOtp
                ? "Generated"
                : "Not available";


    $("dropOtpStatus")
        .textContent =
        ride.dropOtpVerified ||
        ride.dropOTPVerified
            ? "Verified"
            : dropOtp
                ? "Generated"
                : "Not available";


    renderTimeline(ride);


    const customer =
        ride.customer ||
        ride.customerData ||
        {};


    $("customerName")
        .textContent =
        ride.customerName ||
        customer.name ||
        "Customer";


    const phone =
        ride.customerPhone ||
        customer.phone ||
        customer.phoneNumber ||
        "";


    $("customerPhone")
        .textContent =
        phone ||
        "Phone unavailable";


    const call =
        $("callButton");


    if(phone){

        call.disabled = false;

        call.dataset.phone =
            phone;

    }else{

        call.disabled = true;

        call.dataset.phone = "";

    }

}


/* =========================================================
   TIMELINE
========================================================= */

function renderTimeline(ride){

    const fields = {

        timelineRequested:
            [
                ride.createdAt,
                ride.requestedAt
            ],

        timelineAccepted:
            [
                ride.acceptedAt
            ],

        timelinePickup:
            [
                ride.pickupCompletedAt,
                ride.pickedUpAt,
                ride.pickupAt
            ],

        timelineStarted:
            [
                ride.startedAt,
                ride.tripStartedAt
            ],

        timelineCompleted:
            [
                ride.completedAt,
                ride.finishedAt
            ]

    };


    Object.entries(fields)
        .forEach(
            ([id,values]) => {

                const item =
                    $(id);

                const time =
                    values.find(Boolean);


                if(time){

                    item.classList.add(
                        "done"
                    );

                    const span =
                        item.querySelector(
                            "span"
                        );

                    span.textContent =
                        formatDate(time);

                }

            }
        );


    const status =
        statusOf(ride);


    if(
        status === "completed"
    ){

        [
            "timelineRequested",
            "timelineAccepted",
            "timelinePickup",
            "timelineStarted",
            "timelineCompleted"
        ]
        .forEach(
            id =>
                $(id).classList.add(
                    "done"
                )
        );

    }

}


/* =========================================================
   ACTIONS
========================================================= */

$("backButton")
    .addEventListener(
        "click",
        function(){

            if(
                document.referrer &&
                document.referrer.includes(
                    "/rider/"
                )
            ){

                history.back();

            }else{

                location.href =
                    "history.html";

            }

        }
    );


$("backHistory")
    .addEventListener(
        "click",
        function(){

            location.href =
                "history.html";

        }
    );


$("mapButton")
    .addEventListener(
        "click",
        function(){

            const id =
                state.rideId;

            if(!id){

                showToast(
                    "Ride ID unavailable."
                );

                return;

            }


            try{

                sessionStorage.setItem(
                    "goBikeActiveRideId",
                    id
                );

            }catch(error){}


            location.href =
                "live-map.html?rideId=" +
                encodeURIComponent(id);

        }
    );


$("callButton")
    .addEventListener(
        "click",
        function(){

            const phone =
                this.dataset.phone;


            if(!phone){

                showToast(
                    "Customer phone unavailable."
                );

                return;

            }


            location.href =
                "tel:" +
                phone;

        }
    );


/* =========================================================
   TOAST
========================================================= */

let toastTimer;

function showToast(message){

    const toast =
        $("toast");


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    clearTimeout(
        toastTimer
    );


    toastTimer =
        setTimeout(
            () => {

                toast.classList.remove(
                    "show"
                );

            },
            2400
        );

}


/* =========================================================
   INIT
========================================================= */

async function init(){

    state.rideId =
        getRideId();


    if(!state.rideId){

        $("loading")
            .classList.add(
                "hide"
            );

        showToast(
            "Ride details could not be opened."
        );

        return;

    }


    try{

        await loadRide();

        render(
            state.ride
        );

    }catch(error){

        console.error(
            "Go Bike ride details:",
            error
        );

        showToast(
            "Ride details not found."
        );

    }


    $("loading")
        .classList.add(
            "hide"
        );

}


init();

})();
</script>

